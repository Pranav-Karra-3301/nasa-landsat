{
  "name": "landsat-name-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test test/*.test.mjs",
    "landsat:cache": "node scripts/cache-landsat.mjs",
    "landsat:tiles": "node scripts/build-landsat-tiles.mjs",
    "cloudflare:setup": "node scripts/configure-cloudflare.mjs",
    "og:image": "node scripts/build-og-image.mjs",
    "verify:determinism": "node scripts/verify-determinism.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "bench:local": "node scripts/benchmark-local.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "sharp": "^0.34.5",
    "wrangler": "^4.160.1"
  }
}
